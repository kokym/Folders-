rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // helper: is the signed-in user an admin?
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- user profiles ----
    // a user may create/read/update only their OWN profile.
    // role is locked to "member" on create so nobody can self-promote.
    // coins can NEVER be raised by the owner (only an admin top-up can add coins);
    // the owner may lower their own coins + add unlock keys (= paying to read).
    // (to make an admin: edit that user's doc in the Firebase console and set role: "admin")
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == 'member'
                    && request.resource.data.get('coins', 0) == 0;
      allow update: if isAdmin()
                    || ( request.auth != null
                         && request.auth.uid == uid
                         && request.resource.data.get('role', 'member') == resource.data.get('role', 'member')
                         && request.resource.data.get('coins', 0) <= resource.data.get('coins', 0) );
      allow delete: if isAdmin();
    }

    // ---- articles ---- public read, admin write
    match /articles/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- links ---- public read, admin write
    match /links/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- novels (นิยายแบบแบ่งตอน) ---- public read, admin write
    // each chapter is its own doc in novels/{slug}/chapters/{id}
    // (avoids the 1 MB per-document limit so chapter count is effectively unlimited)
    match /novels/{slug} {
      allow read: if true;
      allow write: if isAdmin();
      match /chapters/{cid} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ---- site content + payment settings ---- public read, admin write
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- top-up requests ----
    // a member creates their own request (status must start as "pending");
    // only an admin may read all, approve (add coins) or reject.
    match /topupRequests/{id} {
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ---- comments ----
    // anyone may read; signed-in members may post as themselves;
    // an admin may delete any comment, a member may delete their own;
    // any signed-in user may toggle a like (only the "likes" field may change).
    match /comments/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin()
                    || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
    }
  }
}
